#!/bin/sh
# netoy-dns: DNS helper for the netoy TUI.
#
# Subcommands:
#   test   Ping an IP and a hostname to verify DNS resolution
#
# DNS itself is handled by NetworkManager's dnsmasq plugin (local resolver
# on 127.0.0.1 forwarding upstream). set-plain / set-doh are kept only for
# backward compatibility and are no longer wired to the TUI.

set -e

RESOLV="/etc/resolv.conf"
DNSCRYPT_PIDFILE="/run/dnscrypt-proxy.pid"
DNSCRYPT_CONF="/etc/dnscrypt-proxy/dnscrypt-proxy.toml"

cmd_set_plain() {
    dns1="${1:-}"
    dns2="${2:-}"

    # Build resolv.conf from scratch
    : > "$RESOLV"
    if [ -n "$dns1" ]; then
        echo "nameserver $dns1" >> "$RESOLV"
    fi
    if [ -n "$dns2" ]; then
        echo "nameserver $dns2" >> "$RESOLV"
    fi

    # Stop dnscrypt-proxy if it was running (plain DNS takes over)
    if [ -f "$DNSCRYPT_PIDFILE" ]; then
        kill "$(cat "$DNSCRYPT_PIDFILE" 2>/dev/null)" 2>/dev/null || true
        rm -f "$DNSCRYPT_PIDFILE"
    fi
    rc-service dnscrypt-proxy stop 2>/dev/null || true
}

cmd_set_doh() {
    # Point resolv.conf at the local dnscrypt-proxy listener
    echo "nameserver 127.0.0.1" > "$RESOLV"
    echo "nameserver ::1" >> "$RESOLV"

    # Start dnscrypt-proxy if not already running
    if [ ! -f "$DNSCRYPT_PIDFILE" ] || ! kill -0 "$(cat "$DNSCRYPT_PIDFILE" 2>/dev/null)" 2>/dev/null; then
        rc-service dnscrypt-proxy start 2>/dev/null || \
            dnscrypt-proxy -config "$DNSCRYPT_CONF" -pidfile "$DNSCRYPT_PIDFILE" &
    fi
}

cmd_test() {
    ok=true

    # Resolve a well-known hostname to verify DNS works
    if ping -c 1 -W 3 cloudflare.com >/dev/null 2>&1; then
        echo "OK: resolved cloudflare.com"
    else
        echo "FAIL: could not resolve cloudflare.com"
        ok=false
    fi

    # Direct IP ping to verify basic connectivity
    if ping -c 1 -W 3 1.1.1.1 >/dev/null 2>&1; then
        echo "OK: reached 1.1.1.1"
    else
        echo "FAIL: could not reach 1.1.1.1"
        ok=false
    fi

    if $ok; then
        exit 0
    else
        exit 1
    fi
}

case "${1:-}" in
    set-plain)
        shift
        cmd_set_plain "$@"
        ;;
    set-doh)
        cmd_set_doh
        ;;
    test)
        cmd_test
        ;;
    *)
        echo "Usage: netoy-dns {set-plain [dns1] [dns2]|set-doh|test}" >&2
        exit 1
        ;;
esac
