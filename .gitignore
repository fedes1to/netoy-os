# Build outputs
/out
/out/*
!out/.gitkeep

# ISO artifacts
*.iso
*.iso.sha256
*.iso.sha512
*.tmp

# Cargo / Rust build artifacts
/target
**/target/

# OS-level files
.DS_Store
Thumbs.db

# Editor / IDE
*.swp
*.swo
*~
.vscode/
.idea/

# netoy-tui is tracked as a submodule (see .gitmodules)
# Submodule paths are tracked by git, do NOT ignore the directory itself.

# netoy-tui build artifact copied into the overlay by build-in-container.sh.
# The binary is rebuilt from the submodule source on every build; the tracked
# copy was a stale commit of a local cargo build and must not come back.
overlay/usr/local/bin/netoy-tui

# Build artifacts copied into the overlay by build-in-container.sh (cloned from
# upstream GitHub and built, or curl'd at build time). Rebuilt/refreshed on
# every build, so the committed copies are stale and must not come back.
overlay/usr/local/bin/impala
overlay/var/cache/dnscrypt-proxy/

# Empty npm lockfile left over from scaffolding; repo has no npm project.
package-lock.json
